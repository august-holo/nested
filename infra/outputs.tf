output "url" {
  value = "https://${var.domain_name}"
}

output "user_pool_id" {
  value = aws_cognito_user_pool.main.id
}

output "instance_id" {
  value = aws_instance.api.id
}

# None of the values below are secrets. They are committed so that CI needs
# no configuration in GitHub beyond the repository itself.

resource "local_file" "deploy_env" {
  filename        = "${path.module}/../.github/deploy.env"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (infra/outputs.tf). Do not edit.
    AWS_REGION=${data.aws_region.current.region}
    DEPLOY_ROLE_ARN=${aws_iam_role.github_deploy.arn}
    SITE_BUCKET=${aws_s3_bucket.site.id}
    ARTIFACTS_BUCKET=${aws_s3_bucket.artifacts.id}
    DISTRIBUTION_ID=${aws_cloudfront_distribution.main.id}
    INSTANCE_ID=${aws_instance.api.id}
    DEPLOY_DOCUMENT=${aws_ssm_document.deploy_api.name}
  EOT
}

resource "local_file" "web_env" {
  filename        = "${path.module}/../web/.env"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (infra/outputs.tf). Do not edit.
    NEXT_PUBLIC_COGNITO_AUTHORITY=${local.cognito_issuer}
    NEXT_PUBLIC_COGNITO_DOMAIN=${local.cognito_domain}
    NEXT_PUBLIC_COGNITO_CLIENT_ID=${aws_cognito_user_pool_client.web.id}
  EOT
}
